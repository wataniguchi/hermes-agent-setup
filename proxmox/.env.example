# Copy to proxmox/.env and fill in real values. proxmox/.env is gitignored —
# never commit it (see repo root .gitignore).

# Proxmox host API endpoint, e.g. https://192.168.1.50:8006
PVE_HOST=https://<proxmox-host-ip>:8006

# Proxmox node name (usually "pve" unless renamed at install)
PVE_NODE=pve

# API token ID, format: <user>@<realm>!<token-name>
# Created via: pveum user token add hermes-bridge@pve bridge-token --privsep 0
PVE_TOKEN_ID=hermes-bridge@pve!bridge-token

# The secret printed once by `pveum user token add` — not retrievable after
# creation, only regeneratable (pveum user token remove, then add again).
PVE_TOKEN_SECRET=<paste-secret-here>

# Golden template VMID that clones are cut from (see README_Proxmox.md)
PVE_TEMPLATE_VMID=9000
